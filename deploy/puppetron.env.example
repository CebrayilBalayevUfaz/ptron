# Copy to /etc/puppetron.env and adjust. chmod 600!
PUPPETRON_LISTEN=:8080
PUPPETRON_CONNECT=qemu:///system
PUPPETRON_USER=admin
PUPPETRON_PASSWORD=change-me
PUPPETRON_NOVNC=/opt/puppetron/novnc
#PUPPETRON_TLS_CERT=/etc/ssl/certs/puppetron.pem
#PUPPETRON_TLS_KEY=/etc/ssl/private/puppetron.key
#PUPPETRON_ISO_DIR=/var/lib/libvirt/images
#PUPPETRON_ENABLE_CREATE=true
#PUPPETRON_ALLOW_UNDEFINE=true
#PUPPETRON_ALLOW_XML_EDIT=true
# External websockify instead of the built-in proxy:
#PUPPETRON_WEBSOCKIFY_URL=ws://server:6080/websockify
#PUPPETRON_WEBSOCKIFY_TOKEN_DIR=/var/run/puppetron-tokens
